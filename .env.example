# Texto de urgência no header (ao lado do timer)
VITE_URGENCY_TEXT=Últimas vagas desta condição — encerra em

# Duração do timer em segundos (ex.: 21600 = 6h | 3600 = 1h | 900 = 15min)
VITE_URGENCY_SECONDS=21600

# URL pública do site (sem barra no final) — usada em Open Graph / SEO
# Ex.: https://afiliadoslab.com
VITE_SITE_URL=http://localhost:5173

# URL do checkout
VITE_CHECKOUT_URL=#checkout

# Valor do produto (número). Na página aparece com vírgula e 2 decimais: 497,00
VITE_PRODUCT_PRICE=497

# Texto de parcelas abaixo do valor (livre — o que escrever aqui aparece na tela)
VITE_INSTALLMENTS_TEXT=ou 12x de R$ 45,00 sem juros

# ---------------------------------------------------------------------------
# Modal no checkout (deixe vazio para ir direto ao checkout)
# Valores: lead | waitlist | beta
# Sinônimos aceitos: captura / lista_espera / beta_test
# ---------------------------------------------------------------------------
VITE_MODAL_MODE=

# Obrigatório quando VITE_MODAL_MODE=waitlist ou beta
VITE_WHATSAPP_GROUP_URL=

# Webhook (POST JSON) para captura de lead, lista de espera e voluntários de beta
# Payload: { type, name, email, whatsapp, source, createdAt }
VITE_LEAD_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Analytics (deixe vazio para desligar)
# ---------------------------------------------------------------------------
# Meta Pixel ID (somente números)
VITE_META_PIXEL_ID=

# Google Analytics 4 Measurement ID (ex.: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=
